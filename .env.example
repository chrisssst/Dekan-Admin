# The public GitHub repository to display.
GITHUB_REPO=chrisssst/Dekan

# Admin panel login.
ADMIN_PASSWORD=change-me
ADMIN_SECRET=replace-this-with-a-long-random-string

# Optional. Recommended on Vercel to avoid low unauthenticated GitHub API limits.
# Create a fine-grained token with read-only access to public repository metadata.
GITHUB_TOKEN=
